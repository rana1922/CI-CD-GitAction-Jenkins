<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meditation Camp Registration</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            background: url("https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1920&q=80") no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
        }

        .overlay {
            width: 100%;
            height: 100vh;
            background: rgba(0, 0, 0, 0.45);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            width: 420px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .35);
        }

        h1 {
            text-align: center;
            color: #0d6b58;
            margin-bottom: 10px;
            font-size: 32px;
        }

        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
        }

        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #0d6b58;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #0d6b58;
            color: white;
            font-size: 18px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: #094f41;
        }

        .success {
            background: #d4edda;
            color: #155724;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 18px;
            text-align: center;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 18px;
            text-align: center;
        }

        footer {
            text-align: center;
            margin-top: 25px;
            color: gray;
            font-size: 13px;
        }
    </style>

</head>

<body>

    <div class="overlay">

        <div class="card">

            <h1>🧘 Meditation Camp</h1>

            <p class="subtitle">
                Find Peace • Relax Your Mind • Register Today
            </p>

            <% if(success){ %>
                <div class="success">
                    <%= success %>
                </div>
            <% } %>

            <% if(error){ %>
                <div class="error">
                    <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST">

                <input
                    type="text"
                    name="name"
                    placeholder="Full Name"
                    required
                >

                <input
                    type="email"
                    name="email"
                    placeholder="Email Address"
                    required
                >

                <input
                    type="text"
                    name="contact"
                    placeholder="Contact Number"
                    pattern="[0-9]{10}"
                    required
                >

                <button type="submit">
                    Register Now
                </button>

            </form>

            <footer>
                🌿 Meditation Camp 2026
            </footer>

        </div>

    </div>

</body>

</html>